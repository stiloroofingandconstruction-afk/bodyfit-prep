# BodyFit Prep — plantilla de configuracion
#
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` esta en
# .gitignore y NUNCA debe subirse.
#
# ─────────────────────────────────────────────────────────────────────────────
# NADA DE CLAVES SECRETAS AQUI
#
# Todo lo que empieza por VITE_ acaba dentro del JavaScript que descarga el
# navegador. La clave publishable/anon esta pensada para eso y lo que protege
# los datos es RLS, no el secreto de la clave.
#
# `service_role`, la contrasena de la base de datos y cualquier token de
# administracion NO pueden vivir aqui ni en ningun archivo del frontend. Solo en
# componentes de servidor.
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave anon o publishable>

# disabled | internal | beta | enabled
# Produccion va SIEMPRE en disabled hasta completar la prueba en dos
# dispositivos fisicos.
VITE_SYNC_FLAG=disabled

# Solo para las auditorias de scripts/audit-rls.mjs y scripts/audit-adapter.mjs.
# Son dos usuarios de STAGING creados a proposito para las pruebas.
RLS_TEST_EMAIL_A=
RLS_TEST_PASSWORD_A=
RLS_TEST_EMAIL_B=
RLS_TEST_PASSWORD_B=
